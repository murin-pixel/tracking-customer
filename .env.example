# Google Sheet ต้นทาง
SHEET_ID=
SHEET_GID=976262542
SHEET_TRACKING_COLUMN=G

# Skyfrog: ห้าม commit ไฟล์ .env ที่ใส่รหัสผ่านแล้ว
SKYFROG_CUSTOMER_CODE=
SKYFROG_USERNAME=
SKYFROG_PASSWORD=

# การรัน
REQUEST_TIMEOUT_SECONDS=30
CONCURRENCY=2
REQUEST_DELAY_SECONDS=0.10
OUTPUT_DIR=./outputs
STATE_DB_PATH=./data/status-cache.sqlite

# KEX: PIN 4 หลักสำหรับเปิดหลักฐาน และที่เก็บรูปบนเซิร์ฟเวอร์
KEX_PROOF_PIN=
KEX_PROOF_DIR=./data/kex-proofs
PUBLIC_BASE_URL=https://ffm.example.com

# InterExpress: เลือก "ลูกค้าองค์กร" ในระบบต้นทาง
INTEREXPRESS_USERNAME=
INTEREXPRESS_PASSWORD=

# หน้าเว็บสำหรับทีม CS
# สร้าง PIN 8 หลักและ secret แบบสุ่มก่อนใช้งานจริง
CS_ACCESS_PIN=
WEB_SECRET_KEY=
WEB_SESSION_HOURS=12

# เขียนผลกลับ Google Sheet คอลัมน์ P-R ผ่าน Apps Script Web App
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Shopee Sell Report automation (private runtime folders; never commit them)
SHOPEE_PROFILE=/home/milk/kleanandkare-shopee/session
SHOPEE_REPORT_DIRECTORY=/home/milk/kleanandkare-shopee/sales-reports
SHOPEE_WORK_DIRECTORY=/home/milk/kleanandkare-shopee/work-session
SHOPEE_REPORT_MANIFEST=/home/milk/kleanandkare-shopee/sales-reports/latest-report-manifest.json
SHOPEE_REPORT_GLOB=Order.all.*.xlsx
